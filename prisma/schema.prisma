// ============================================================
// Prisma Schema для RankKursant
// ============================================================
// Этот файл описывает структуру базы данных.
// При подключении бэкенда: npx prisma migrate dev --name init
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ МОДЕЛИ ============

/// Пользователь системы (преподаватель или курсант)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // В реальности — bcrypt hash
  fullName  String
  role      Role     @default(CADET)
  groupId   String?
  group     Group?   @relation(fields: [groupId], references: [id])
  cadet     Cadet?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

/// Роль пользователя
enum Role {
  TEACHER
  CADET
}

/// Группа курсантов
model Group {
  id      String   @id @default(cuid())
  name    String   // Полное название: "Взвод учебный 201"
  number  String   // Краткий номер: "ВУ-201"
  users   User[]
  cadets  Cadet[]
  createdAt DateTime @default(now())

  @@map("groups")
}

/// Курсант (привязан к User и Group)
model Cadet {
  id       String   @id @default(cuid())
  userId   String   @unique
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id])
  fullName String
  scores   ScoreRecord[]
  createdAt DateTime @default(now())

  @@map("cadets")
}

/// Запись о начислении баллов
model ScoreRecord {
  id          String   @id @default(cuid())
  cadetId     String
  cadet       Cadet    @relation(fields: [cadetId], references: [id], onDelete: Cascade)
  category    ScoreCategory
  points      Int
  description String   @default("")
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([cadetId])
  @@index([category])
  @@map("score_records")
}

/// Категория начисления баллов
enum ScoreCategory {
  CLASSROOM     // Оценки на занятии
  INDEPENDENT   // Самостоятельная работа
  ADDITIONAL    // Дополнительные задания
  ARTICLES      // Написание статей
}

/// Конфигурация категории (лимиты баллов)
model CategoryConfig {
  id          String        @id @default(cuid())
  category    ScoreCategory @unique
  name        String
  maxPoints   Int
  description String        @default("")
  updatedAt   DateTime      @updatedAt

  @@map("category_configs")
}

/// Сессия для аутентификации (NextAuth)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
