# ============================================================
# Переменные окружения для RankKursant
# ============================================================
# Скопируйте в .env и заполните значениями
# ============================================================

# --- База данных ---
DATABASE_URL="postgresql://user:password@localhost:5432/rankkursant?schema=public"

# --- NextAuth (аутентификация) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"

# --- Приложение ---
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="RankKursant"
